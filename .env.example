# Instagram Graph API Credentials
# Replace these with your actual credentials from developers.facebook.com

# Your Instagram Professional (Creator or Business) Account ID
# (Get this via GET /me/accounts?fields=instagram_business_account)
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here

# Meta Graph API Long-Lived User or Page Access Token (valid for 60 days)
INSTAGRAM_ACCESS_TOKEN=your_meta_long_lived_access_token_here

# Meta Graph API Version (defaults to v22.0)
GRAPH_API_VERSION=v22.0
